{
  "redirects": [
    {
      "source": "/bio",
      "destination": "/criar-conta?volta=/painel/comercial&de=bio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/t/:codigo",
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/baixar",
      "destination": "/baixar/index.html"
    },
    {
      "source": "/para-revit",
      "destination": "/para-revit/index.html"
    },
    {
      "source": "/versoes",
      "destination": "/versoes/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
